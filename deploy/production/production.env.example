# Copy to a host-only file such as /etc/daemonstate/production.env and chmod 0600.
# Pin every image by digest before deployment.
COMPOSE_PROJECT_NAME=daemonstate-production
DAEMONSTATE_IMAGE=ghcr.io/your-org/daemonstate:0.3.0@sha256:REPLACE_WITH_64_LOWERCASE_HEX
POSTGRES_IMAGE=pgvector/pgvector:0.8.5-pg16-bookworm@sha256:REPLACE_WITH_64_LOWERCASE_HEX
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:REPLACE_WITH_64_LOWERCASE_HEX
REDIS_IMAGE=redis:7.4.5-alpine@sha256:REPLACE_WITH_64_LOWERCASE_HEX
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0@sha256:REPLACE_WITH_64_LOWERCASE_HEX
PULL_POLICY=always
RELEASE_SHA=replace-with-release-git-sha

# Public TLS endpoint. DNS must resolve to this host and ports 80/443 must be reachable.
DAEMONSTATE_DOMAIN=context.example.com
ACME_EMAIL=operations@example.com
BIND_ADDRESS=0.0.0.0

# Absolute paths are recommended. Files must be owned by the account running
# Docker Compose and chmod 0600.
POSTGRES_ADMIN_PASSWORD_FILE=/etc/daemonstate/secrets/postgres_admin_password
POSTGRES_APP_PASSWORD_FILE=/etc/daemonstate/secrets/postgres_app_password
SERVER_API_KEY_FILE=/etc/daemonstate/secrets/server_api_key
ENCRYPTION_KEY_FILE=/etc/daemonstate/secrets/encryption_key
METRICS_BEARER_TOKEN_FILE=/etc/daemonstate/secrets/metrics_bearer_token
DAEMONSTATE_PROJECT_PATH=/srv/daemonstate/workspace

# Optional secret files. Omit a variable to mount the repository's empty secret.
# PREVIOUS_ENCRYPTION_KEYS_FILE=/etc/daemonstate/secrets/previous_encryption_keys
# Principal API keys are deliberately unsupported by this single-tenant
# production profile until every API and MCP mutation has action-level scopes.
# LITELLM_API_KEY_FILE=/etc/daemonstate/secrets/litellm_api_key
# GOOGLE_CLIENT_SECRET_FILE=/etc/daemonstate/secrets/google_client_secret
# SLACK_CLIENT_SECRET_FILE=/etc/daemonstate/secrets/slack_client_secret

POSTGRES_DB=daemonstate
POSTGRES_ADMIN_USER=daemonstate_admin
POSTGRES_APP_USER=daemonstate_app
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WORK_MEM=8MB

APP_WORKERS=1
SERVE_FRONTEND=false
APP_MAX_CONCURRENCY=200
API_RATE_LIMIT_PER_MINUTE=120
AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=16777216
MAX_REQUEST_BODY_SIZE=16MB
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
MIGRATION_STATEMENT_TIMEOUT_MS=0
MIGRATION_LOCK_TIMEOUT_MS=30000
SYNC_WORKER_JOB_TIMEOUT_SECONDS=1800
SYNC_WORKER_METRICS_PORT=9101
SYNC_WORKER_HEALTH_INTERVAL_SECONDS=15
SOURCE_INGESTION_SWEEP_LIMIT=10
SOURCE_INGESTION_TIMEOUT_SECONDS=300
SOURCE_INGESTION_MAX_ATTEMPTS=5
PGVECTOR_INDEX_DIMENSION=1024
PGVECTOR_CANDIDATE_LIMIT=200
ALLOW_HASHING_EMBEDDER=false
EXTRACTION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Optional metadata-only OpenTelemetry export. Production requires HTTPS.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=daemonstate-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel.example.com/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_SAMPLE_RATIO=1.0

# Configure each provider as a complete client-id/secret/HTTPS-redirect trio.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=
SLACK_CLIENT_ID=
SLACK_REDIRECT_URI=
SLACK_MANAGED_INSTALL_URL=

# Tune after measuring the host and workload.
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=2G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=384M
PROXY_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=256M
PROMETHEUS_MEMORY_LIMIT=512M
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
