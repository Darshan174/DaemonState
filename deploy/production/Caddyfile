{
	email {$ACME_EMAIL}
	admin off
	grace_period 10s

	servers {
		protocols h1 h2 h3
	}
}

{$DAEMONSTATE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	request_body {
		max_size {$MAX_REQUEST_BODY_SIZE:16MB}
	}

	@internal_metrics path /metrics
	respond @internal_metrics 404

	@oauth_flows path /api/connectors/*/install /api/connectors/*/callback /api/connectors/*/install/ /api/connectors/*/callback/ /api/connectors/slack/managed/install /api/connectors/slack/managed/install/
	log_skip @oauth_flows

	reverse_proxy app:8000 {
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /health/ready
		health_interval 15s
		health_timeout 5s
		fail_duration 30s
		max_fails 3

		transport http {
			dial_timeout 5s
			response_header_timeout 120s
			keepalive 30s
		}
	}

	log {
		output stdout
		format json
	}
}
