# Context Engine local configuration
# Copy to .env before running the bare-metal or Docker setup paths.

# App and storage
ENVIRONMENT=development
RELEASE_SHA=dev
APP_WORKERS=1
DATABASE_URL=sqlite+aiosqlite:///data/context.db
DATA_DIR=./data
PORT=8000
WORKERS=1
CONTEXT_ENGINE_PROJECT_PATH=.
AUTO_MIGRATE=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
MIGRATION_STATEMENT_TIMEOUT_MS=0
MIGRATION_LOCK_TIMEOUT_MS=30000

# Docker PostgreSQL. Change this before any non-local deployment.
POSTGRES_PASSWORD=contextengine

# Optional answer/extraction and embedding models
LITELLM_API_KEY=
EXTRACTION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
ENABLE_LOCAL_EMBEDDER=false
ALLOW_HASHING_EMBEDDER=false
PGVECTOR_INDEX_DIMENSION=1024
PGVECTOR_CANDIDATE_LIMIT=200

# Optional API and credential protection
SERVER_API_KEY=
PRINCIPAL_API_KEYS=
API_RATE_LIMIT_PER_MINUTE=0
AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=
RATE_LIMIT_FAIL_OPEN=true
ENCRYPTION_KEY=
PREVIOUS_ENCRYPTION_KEYS=
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=false
ALLOWED_REPO_ROOTS=
MAX_REQUEST_BODY_BYTES=16777216
API_DOCS_ENABLED=true
DEMO_ENDPOINTS_ENABLED=true
SERVE_FRONTEND=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
LOG_LEVEL=INFO
LOG_FORMAT=console

# Connector worker
SYNC_WORKER_LEASE_SECONDS=300
SYNC_WORKER_RETRY_BASE_SECONDS=30
SYNC_WORKER_RETRY_MAX_SECONDS=900
SYNC_WORKER_POLL_INTERVAL_SECONDS=2
SYNC_WORKER_JOB_TIMEOUT_SECONDS=1800
SYNC_WORKER_METRICS_PORT=0
SYNC_WORKER_HEALTH_FILE=/tmp/context-engine-sync-worker.ready
SYNC_WORKER_HEALTH_INTERVAL_SECONDS=15
SOURCE_INGESTION_SWEEP_LIMIT=10
SOURCE_INGESTION_TIMEOUT_SECONDS=300
SOURCE_INGESTION_MAX_ATTEMPTS=5

# Now-page digest cache
CONTEXT_DIGEST_CACHE_TTL_SECONDS=30
CONTEXT_DIGEST_CACHE_MAX_ENTRIES=32

# Public callback base URL, for example https://context.example.com
PUBLIC_BASE_URL=

# Google OAuth (Gmail and Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_MANAGED_INSTALL_URL=

# Zoom remains coming soon; these values are reserved for future support.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# Optional local coding-session locations. Defaults are discovered when blank.
CODEX_HOME=
CLAUDE_HOME=
OPENCODE_HOME=
