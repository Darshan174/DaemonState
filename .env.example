# DaemonState local configuration shared by the workstation and personal
# Docker profiles. Each setting below is labeled when it belongs to only one.

# App and storage
COMPOSE_PROJECT_NAME=daemonstate
ENVIRONMENT=development
RELEASE_SHA=dev
APP_WORKERS=1
# Workstation only; Docker supplies its internal PostgreSQL URL and /data path.
DATABASE_URL=sqlite+aiosqlite:///data/context.db
DATA_DIR=./data
PORT=8000
WORKERS=1
# Keep local action endpoints loopback-only. Set another address only behind
# explicit API authentication and a trusted local-action boundary.
BIND_ADDRESS=127.0.0.1
DAEMONSTATE_PROJECT_PATH=.
# Workstation only; Docker uses its explicit one-shot migration service.
AUTO_MIGRATE=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
MIGRATION_STATEMENT_TIMEOUT_MS=0
MIGRATION_LOCK_TIMEOUT_MS=30000

# Docker PostgreSQL. Change this before any non-local deployment.
POSTGRES_PASSWORD=daemonstate

# Optional answer/extraction and embedding models
LITELLM_API_KEY=
EXTRACTION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
ALLOW_HASHING_EMBEDDER=false
PGVECTOR_INDEX_DIMENSION=1024
PGVECTOR_CANDIDATE_LIMIT=200

# Optional API and credential protection
SERVER_API_KEY=
PRINCIPAL_API_KEYS=
API_RATE_LIMIT_PER_MINUTE=0
AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=
RATE_LIMIT_FAIL_OPEN=true
ENCRYPTION_KEY=
PREVIOUS_ENCRYPTION_KEYS=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=false
ALLOWED_REPO_ROOTS=
MAX_REQUEST_BODY_BYTES=16777216
API_DOCS_ENABLED=true
DEMO_ENDPOINTS_ENABLED=true
SERVE_FRONTEND=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
LOG_LEVEL=INFO
LOG_FORMAT=console

# Optional metadata-only OpenTelemetry traces. Disabled by default.
# Use an HTTPS OTLP/HTTP traces endpoint in production.
OTEL_ENABLED=false
OTEL_CONTENT_CAPTURE=false
OTEL_SERVICE_NAME=daemonstate-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_SAMPLE_RATIO=1.0
OTEL_BATCH_MAX_QUEUE_SIZE=2048
OTEL_BATCH_MAX_EXPORT_BATCH_SIZE=512
OTEL_BATCH_SCHEDULE_DELAY_MS=5000

# Connector worker
SYNC_WORKER_LEASE_SECONDS=300
SYNC_WORKER_RETRY_BASE_SECONDS=30
SYNC_WORKER_RETRY_MAX_SECONDS=900
SYNC_WORKER_POLL_INTERVAL_SECONDS=2
SYNC_WORKER_JOB_TIMEOUT_SECONDS=1800
SYNC_WORKER_METRICS_PORT=0
SYNC_WORKER_HEALTH_FILE=/tmp/daemonstate-sync-worker.ready
SYNC_WORKER_HEALTH_INTERVAL_SECONDS=15
SOURCE_INGESTION_SWEEP_LIMIT=10
SOURCE_INGESTION_TIMEOUT_SECONDS=300
SOURCE_INGESTION_MAX_ATTEMPTS=5

# Now-page digest cache
CONTEXT_DIGEST_CACHE_TTL_SECONDS=30
CONTEXT_DIGEST_CACHE_MAX_ENTRIES=32

# Maximum time for one visible continuation agent turn (four hours by default).
CONTINUATION_COMMAND_TIMEOUT_SECONDS=14400
# Visible Session Context only. compact_v2 is the default and renders Goal /
# State now / Start here / Do not repeat / Done when; legacy_v1 remains the
# emergency rollback. Automatic execution prompts are intentionally unaffected.
SESSION_HANDOFF_BRIEF_VARIANT=compact_v2

# Public callback base URL, for example https://daemonstate.example.com
PUBLIC_BASE_URL=

# Google OAuth (Gmail and Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_MANAGED_INSTALL_URL=

# Zoom remains coming soon; these values are reserved for future support.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# Optional local coding-session locations. Defaults are discovered when blank.
CODEX_HOME=
CLAUDE_HOME=
OPENCODE_HOME=

# Optional Codex CLI override. When blank, the current desktop-bundled CLI is
# preferred over a stale npm-global wrapper.
DAEMONSTATE_CODEX_EXECUTABLE=
