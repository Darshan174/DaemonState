# daemonstate.com defaults to waitlist-only at runtime. Set this explicitly to
# force waitlist mode on a preview host or product mode on the public host.
VITE_WAITLIST_ONLY=

# Managed waitlist and approved-user signup. Create a free Clerk application,
# switch its Access mode to Waitlist, then add its publishable key here. When
# this is blank, the landing page keeps the same-origin D1 waitlist fallback.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional public PostHog project configuration. The project key is designed
# for browser use; never place a PostHog personal API key here.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
